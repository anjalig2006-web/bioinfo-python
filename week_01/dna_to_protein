from codon_table import codon_table

def main():

    # Take DNA sequence input from the user
    dna = input ("Enter the DNA sequence: ").upper().strip()
    print ("DNA sequence: ", dna)

    # Print the transcribed sequence of user input
    mRNA = transcribe(dna)
    print ("The transcription of entered DNA sequence is: ", mRNA)

    # Print translated sequence of transcribed mRNA
    p = translate(mRNA)
    print ("The translation of mRNA sequence is: ", p)

def transcribe(dna):
    # Generate mRNA
    sequence = ""
    for letter in dna:
        if letter == "A":
            sequence += "U"
        elif letter == "T":
            sequence += "A"
        elif letter == "G":
            sequence += "C"
        elif letter == "C":
            sequence += "G"
    return sequence

def translate(mRNA):
    # Generate protein sequence
    protein = ""
    # Check if the mRNA sequence contains a start codon - methionine (AUG)
    if "AUG" not in mRNA:
        return ""
    start = mRNA.find("AUG")
    # Form codon from mRNA sequence
    for i in range (start, (len(mRNA)), 3):
        codon = mRNA[i:i+3]
        # Codon length should not be less than 3
        if len(codon)<3:
            break
        # Put amino acid in the sequence based on codon formed according to the codon_table
        amino_acid = codon_table[codon]
        # Stop translation when a STOP codon is encountered
        if amino_acid == "STOP":
            break
        # Add amino acid sequence to the protein
        protein += amino_acid
        
    return protein

# Call main
if __name__ == "__main__":
    main()
